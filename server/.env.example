# ── Core ─────────────────────────────────────────────────────────────
PORT=8000
ALLOWED_ORIGINS=*

# ── Supabase (auth + persistence) ────────────────────────────────────
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
# Legacy projects sign JWTs with HS256 using this secret (Project Settings → API → JWT Secret).
# Projects on asymmetric signing keys need only SUPABASE_URL (JWKS is fetched automatically).
SUPABASE_JWT_SECRET=

# ── Hardware ─────────────────────────────────────────────────────────
# Shared secret the ESP32 sends. Server refuses device traffic if this is empty.
# Generate: python -c "import secrets;print(secrets.token_urlsafe(32))"
DEVICE_API_KEY=
# Sensor rotation when no sensor is pinned: command:seconds,...
SENSOR_SEQUENCE=read_max30102:15,read_dht11:4,read_ad8232:6
# Unpaired devices (single-user prototype) are attributed to this user id. Leave empty to require pairing.
DEFAULT_OWNER_USER_ID=
# Shipped firmware posts reminder-ack without a key. Set false after adding api_key to that request.
LEGACY_UNAUTH_REMINDER_ACK=true

# ── Persistence tuning ───────────────────────────────────────────────
PERSIST_INTERVAL_S=30
# Keep the old web dashboard (device_live_stream table) fed. Throttled to once per MIRROR_INTERVAL_S.
MIRROR_LIVE_STREAM=false
MIRROR_INTERVAL_S=5

# ── AI / RAG (Gemini + optional OpenAI / HuggingFace) ────────────────
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
OPENAI_API_KEY=
OPENAI_MEDISCAN_MODEL=gpt-4.1-mini
HUGGINGFACE_API_KEY=
HUGGINGFACE_MODEL=meta-llama/Llama-3.1-8B-Instruct
AI_TEXT_PROVIDER=gemini
LLM_TIMEOUT_S=30

# ── SOS delivery (Brevo: Email + SMS + WhatsApp) ─────────────────────
BREVO_API_KEY=
BREVO_FROM_EMAIL=
BREVO_FROM_NAME=Jeevan
BREVO_SMS_SENDER=Jeevan
BREVO_WHATSAPP_SENDER_NUMBER=
BREVO_WHATSAPP_SOS_TEMPLATE_ID=
BREVO_WHATSAPP_SAFE_TEMPLATE_ID=
BREVO_WHATSAPP_VIDEO_INVITE_TEMPLATE_ID=
BREVO_WHATSAPP_MEDICATION_TEMPLATE_ID=
APP_PUBLIC_URL=http://localhost:5173

# ── TomTom Maps, Hospitals, Traffic & Routing ────────────────────────
TOMTOM_API_KEY=

# ── OpenWeatherMap (Weather Radar + Disaster Risk Score) ─────────────
OPENWEATHER_KEY=

# ── Agora Live Video / Telemedicine & Emergency Room ─────────────────
AGORA_APP_ID=
AGORA_APP_CERTIFICATE=
